# Copy to .env for local dev (gitignored). CI copies this file before analyze/build.
REOWN_PROJECT_ID=
EREBRUS_WEB_ORIGIN=
GATEWAY_URL=

# Optional override of the Google server (web) client id; the production id is
# built in. Its audience must be in the gateway's GOOGLE_CLIENT_IDS.
GOOGLE_SERVER_CLIENT_ID=
# Android only: set to true once this build's signing-key SHA-1 is registered
# for com.erebrus.vpn in Google Cloud (otherwise Google fails with code 10).
GOOGLE_LOGIN_ENABLED=