<?xml version="1.0" encoding="utf-8"?>
<!-- API 24-30 equivalent of data_extraction_rules.xml: back everything up
     except the secure store, whose Keystore-wrapped contents cannot be read on
     another device anyway. -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration.xml"/>
</full-backup-content>
